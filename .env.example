# Conexion a PostgreSQL (Supabase / Neon / local)
# La password se guarda en el Service Role / password de la base, NO en el repo.
DATABASE_URL="postgresql://postgres.PASTE_AQUI:PASSWORD@PASTE_AQUI.pooler.supabase.com:6543/postgres?sslmode=require"
# Conexion directa a PostgreSQL para migraciones (puerto 5432, sin transaction pooler).
DIRECT_URL="postgresql://postgres.PASTE_AQUI:PASSWORD@PASTE_AQUI:5432/postgres?sslmode=require"

# Secretos de la aplicacion (generar con: openssl rand -base64 48)
AUTH_SECRET="cambiame-por-un-secreto-aleatorio-de-al-menos-32-caracteres"

# URL base para los links de los correos de confirmacion
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase (solo si se usan servicios de Supabase ademas de Postgres)
# OJO: la publishable key es publica por diseño; la service role key NO va acá.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://ihwsccsdlvaxfrzbvctt.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xn7R5TMs9INkQFARhQh2AQ_964LdrSg"

# ---------------------------------------------------------------------------
# Programacion de vuelos (RF-01): minutos minimos entre dos salidas del mismo
# aeropuerto. Opcional, por defecto 20. Lo definen los planificadores.
# ---------------------------------------------------------------------------
MIN_DEPARTURE_GAP_MINUTES="20"
# Minutos minimos entre el aterrizaje de un avion y su siguiente despegue
# (desembarque, combustible, etc.). Opcional, por defecto 120.
MIN_TURNAROUND_MINUTES="120"



#Clerk Configuración
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
