# PostgreSQL local exclusivo para pruebas de integración US-10A.
# Copiar a .env.test (ignorado por Git) y cambiar solo el valor de ejemplo.
# No usar valores de .env.local, Supabase ni bases remotas.

POSTGRES_TEST_HOST=127.0.0.1
POSTGRES_TEST_PORT=55432
POSTGRES_TEST_DB=aerogestion_us10a_test
POSTGRES_TEST_USER=aerogestion_us10a_test
POSTGRES_TEST_PASSWORD=cambiar_esta_clave_solo_test

# Opcional para pruebas HTTP con una instancia Clerk de test.
# Nunca usar las claves de producción en este archivo.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
